# Highnet Safe LLM Tools configuration (both products). Copy to .env for local development; on Fly.io set the secrets
# with `fly secrets set` and the rest in fly.toml [env]. Defaults are shown; every variable
# is read and validated in api/src/highnet_rag/config.py.

# --- Providers (secrets) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Vercel AI Gateway key: Scope's second judge (a decision model). Only recording and evals use it.
AI_GATEWAY_API_KEY=
# Salt for hashing visitor IPs before they are stored (secret; any long random string).
IP_HASH_SALT=change-me

# Offline stand-ins (hashed word vectors + extractive "LLM"). No keys, no cost, illustrative
# output only. Use with `highnet-rag ingest --fake` for a fully local run.
FAKE_PROVIDERS=false

# --- Models -------------------------------------------------------------------------------
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5
CLAUDE_MODEL_DEMO=claude-opus-5
CLAUDE_MODEL_JUDGE=claude-sonnet-5
# true = answer with CLAUDE_MODEL_DEMO instead of CLAUDE_MODEL_DEFAULT (for recorded demos).
DEMO_MODE=false
MAX_ANSWER_TOKENS=1024
# Anthropic SDK retries on 429/5xx. Low for live questions; the eval workflow raises it.
ANTHROPIC_MAX_RETRIES=2

VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBED_MODEL=voyage-3.5-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
EMBED_DIMS=1024
# Voyage retries on 429/5xx. Short for live questions; the corpus build and evals raise both.
VOYAGE_MAX_RETRIES=2
VOYAGE_MAX_RETRY_WAIT_SECONDS=10

# Scope's second judge: a decision model through Vercel AI Gateway (typed answers, probabilities).
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
DECISION_MODEL=typesafe-ai/jev
AI_GATEWAY_MAX_RETRIES=2

# --- Storage ------------------------------------------------------------------------------
CORPUS_DB_PATH=data/corpus.sqlite
STATE_DB_PATH=data/state.sqlite
# Built Next.js export served at /. Build it with `npm run build` in web/.
STATIC_DIR=web/out
# Visitors pick from pre-recorded questions and the page replays the recorded run (no model
# call, no cost). true = free-text questions answered live again.
LIVE_QUERIES=false
RECORDINGS_DB_PATH=data/recordings.sqlite
# 1 = the recorded pace (pauses capped at 1.5 s), 2 = twice as fast.
REPLAY_SPEED=1
# --- Scope ----------------------------------------------------------------------------------
# Built by `highnet-scope ingest`, filled by `highnet-scope record` (committed under recordings/).
SCOPE_DB_PATH=data/scope.sqlite
# false: visitors replay the recorded model calls only (no model call, nothing spent).
# true: free-text messages are embedded and judged live, paid from the shared budget.
SCOPE_LIVE=false
SCOPE_MAX_MESSAGE_CHARS=2000
# Earlier conversation turns read with the message when context is on.
SCOPE_CONTEXT_TURNS=4
# 1 = model steps replay at their recorded pace (pauses capped at 1.5 s), 2 = twice as fast.
SCOPE_REPLAY_SPEED=1
# Hard caps on what the product says back (output tokens, then characters).
SCOPE_ANSWER_MAX_TOKENS=300
SCOPE_BRIEF_MAX_TOKENS=120
SCOPE_ANSWER_MAX_CHARS=1500
SCOPE_BRIEF_MAX_CHARS=500

# Published eval results, served at /api/evals.
EVALS_RESULTS_PATH=evals/results/latest.json
# Seconds between SSE keep-alive comments while a stage runs.
SSE_KEEPALIVE_SECONDS=15

# --- Budget and rate limits ---------------------------------------------------------------
BUDGET_MONTHLY_USD=20
# Fraction of the cap at which expensive features switch off.
BUDGET_DEGRADE_AT=0.8
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=200
# JSON map of model -> USD per 1M tokens, overriding api/src/highnet_rag/pricing.py.
# PRICE_OVERRIDES={"claude-haiku-4-5": {"input": 1.0, "output": 5.0}}

# --- Query limits -------------------------------------------------------------------------
MAX_QUERY_CHARS=500
DEFAULT_TOP_K=5
MAX_TOP_K=10
AGENT_MAX_STEPS=4
# Input + output tokens across one question's agent turns, and the output cap per turn.
AGENT_TOKEN_CAP=30000
AGENT_TURN_MAX_TOKENS=512

# --- Cross-origin access (web on Vercel, API on Fly) ---------------------------------------
# Comma-separated exact origins allowed to call the API, e.g. the Vercel production domain
# and `next dev`. Preview deployments are matched by CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://highnet-[a-z0-9-]+-highnets-projects\.vercel\.app$
# The judge model for Scope is CLAUDE_MODEL_DEFAULT (claude-haiku-4-5).

# --- Frontend (Vercel project env / web/.env.local) -----------------------------------------
# Where the browser finds the API. Empty = same origin (local `highnet-rag serve` with web/out).
# NEXT_PUBLIC_API_BASE=https://highnet-safe-llm-tools.fly.dev
# The public address, for canonical links, the sitemap and share cards (default: the Vercel URL).
# NEXT_PUBLIC_SITE_URL=https://highnet-safe-llm-tools.vercel.app
