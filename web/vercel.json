{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/corpus",
      "destination": "/rag/corpus/",
      "permanent": true
    },
    {
      "source": "/corpus/",
      "destination": "/rag/corpus/",
      "permanent": true
    },
    {
      "source": "/evals",
      "destination": "/rag/evals/",
      "permanent": true
    },
    {
      "source": "/evals/",
      "destination": "/rag/evals/",
      "permanent": true
    },
    {
      "source": "/coverage",
      "destination": "/rag/coverage/",
      "permanent": true
    },
    {
      "source": "/coverage/",
      "destination": "/rag/coverage/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "destination": "/rag/",
      "permanent": true
    }
  ]
}
