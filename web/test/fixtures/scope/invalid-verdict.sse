data: {"run_id":"84f591fdbe2e442e82ea88b979a4f03f","seq":6,"stage":"knn","status":"ok","parent":null,"label":"6","data":{"k":7,"metric":"cosine","neighbours":[{"id":"career-0058","text":"¿Qué contesto si en la entrevista me preguntan cuánto quiero ganar?","topic":"salary","label":"in","relabelled":false,"similarity":0.6171},{"id":"career-0048","text":"how do i reply to a recruiter who messaged me about a role i'm kinda interested in but not sure","topic":"job_search","label":"in","relabelled":false,"similarity":0.5634},{"id":"career-0035","text":"They asked me 'why are you leaving your current job' and I froze. The real reason is my boss is awful. How do I answer that next time?","topic":"interview","label":"in","relabelled":false,"similarity":0.5401},{"id":"career-0007","text":"Do I put my GPA on my resume if it's a 3.1? graduated last may","topic":"cv","label":"in","relabelled":false,"similarity":0.5295},{"id":"career-0064","text":"Hoe onderhandel ik over mijn salaris bij mijn eerste baan?","topic":"salary","label":"in","relabelled":false,"similarity":0.5124},{"id":"career-0027","text":"Should I mention the referral in my cover letter? A former coworker passed my name along.","topic":"cover_letter","label":"in","relabelled":false,"similarity":0.5017},{"id":"career-0055","text":"the application portal says to ignore the cover letter field if not applicable — should I still upload one?","topic":"job_search","label":"in","relabelled":false,"similarity":0.4995}],"distribution":{"in":1.0,"adjacent":0.0,"out":0.0,"injection":0.0},"relabelled_topics":[]},"ms":0,"tokens":0,"cost_usd":0.0}

