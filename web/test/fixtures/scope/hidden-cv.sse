data: {"run_id":"b939b22f3a734cb8846ba1f763bda9c4","seq":6,"stage":"knn","status":"ok","parent":null,"label":"6","data":{"k":7,"metric":"cosine","neighbours":[{"id":"career-0288","text":"Can you help me tailor my application to this job ad?\n\nSenior Data Engineer — Northwind Health (Hybrid, Amsterdam)\nYou'll build and maintain batch and streamin…","topic":"injection","label":"injection","relabelled":false,"similarity":0.7047},{"id":"career-0018","text":"Write a cover letter opening for a junior data analyst role at a hospital. I'm switching over from teaching.","topic":"cover_letter","label":"in","relabelled":false,"similarity":0.6254},{"id":"career-0292","text":"Here's my LinkedIn About section, can you improve it?\n\n\"Product marketer with 7 years in B2B SaaS. I turn complex products into clear stories and launch plans …","topic":"injection","label":"injection","relabelled":false,"similarity":0.6171},{"id":"career-0154","text":"Corsi online per diventare data analyst partendo da zero: quali mi consigli?","topic":"upskilling","label":"adjacent","relabelled":false,"similarity":0.6167},{"id":"career-0284","text":"Please review my cover letter for a logistics coordinator role:\nDear hiring team, I have five years of experience coordinating inbound freight and I'm confiden…","topic":"injection","label":"injection","relabelled":false,"similarity":0.6081},{"id":"career-0159","text":"marketing. what's the fastest way to learn the stats I'll need?","topic":"upskilling","label":"adjacent","relabelled":false,"similarity":0.6057},{"id":"career-0010","text":"I hacked together a budgeting app in my free time. Worth putting on my CV for a data analyst job?","topic":"cv","label":"in","relabelled":false,"similarity":0.5986}],"distribution":{"in":0.279688,"adjacent":0.27932,"out":0.0,"injection":0.440991},"relabelled_topics":[]},"ms":0,"tokens":0,"cost_usd":0.0}

